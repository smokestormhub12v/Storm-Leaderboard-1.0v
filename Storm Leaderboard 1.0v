-- Smooth Slide Animation for Toggle
local isOpen = true
local tweenInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

ToggleBtn.MouseButton1Click:Connect(function()
    isOpen = not isOpen
    ToggleBtn.Text = isOpen and "↑" or "↓"
    
    -- Slide up off-screen when closing, slide back down when opening
    local targetPos = isOpen and UDim2.new(1, -205, 0, 42) or UDim2.new(1, -205, 0, -200)
    local tween = TweenService:Create(MainFrame, tweenInfo, {Position = targetPos})
    tween:Play()
end)

-- Helper: Get Player Score
local function getPlayerScore(player)
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        for _, stat in ipairs(leaderstats:GetChildren()) do
            if stat:IsA("IntValue") or stat:IsA("NumberValue") then
                return stat.Value, stat.Name
            end
        end
    end
    return 0, "Score"
end

-- Helper: Real Ping with Green (< 150ms) / Red (>= 150ms) Coloring
local function getPlayerPingData(player)
    if player == LocalPlayer then
        local success, pingSec = pcall(function()
            return player:GetNetworkPing()
        end)
        if success and pingSec then
            local pingMs = math.floor(pingSec * 1000)
            if pingMs <= 0 then
                pcall(function()
                    pingMs = math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue())
                end)
            end
            local color = (pingMs < 150) and Color3.fromRGB(80, 255, 120) or Color3.fromRGB(255, 80, 80)
            return pingMs .. "ms", color
        end
    end
    return "OK", Color3.fromRGB(80, 255, 120)
end

-- Update Leaderboard UI
local function updateLeaderboard()
    for _, child in ipairs(ScrollingFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local players = Players:GetPlayers()
    
    table.sort(players, function(a, b)
        local scoreA = getPlayerScore(a)
        local scoreB = getPlayerScore(b)
        return scoreA > scoreB
    end)

    for _, player in ipairs(players) do
        local scoreVal, statName = getPlayerScore(player)
        local pingStr, pingColor = getPlayerPingData(player)

        local Row = Instance.new("TextButton")
        Row.Size = UDim2.new(1, 0, 0, 26)
        Row.BackgroundColor3 = (player == LocalPlayer) and Color3.fromRGB(35, 45, 75) or Color3.fromRGB(24, 24, 34)
        Row.BackgroundTransparency = 0.5
        Row.AutoButtonColor = true
        Row.Text = ""
        Row.Parent = ScrollingFrame

        local RowCorner = Instance.new("UICorner")
        RowCorner.CornerRadius = UDim.new(0, 6)
        RowCorner.Parent = Row

        -- Name Label (Super small clean text)
        local NameLabel = Instance.new("TextLabel")
        NameLabel.Size = UDim2.new(0.52, 0, 1, 0)
        NameLabel.Position = UDim2.new(0, 6, 0, 0)
        NameLabel.BackgroundTransparency = 1
        NameLabel.Text = player.DisplayName ~= "" and player.DisplayName or player.Name
        NameLabel.TextColor3 = Color3.fromRGB(240, 240, 240)
        NameLabel.TextSize = 10
        NameLabel.Font = Enum.Font.GothamMedium
        NameLabel.TextXAlignment = Enum.TextXAlignment.Left
        NameLabel.Parent = Row

        -- Score Label
        local ScoreLabel = Instance.new("TextLabel")
        ScoreLabel.Size = UDim2.new(0.25, 0, 1, 0)
        ScoreLabel.Position = UDim2.new(0.52, 0, 0, 0)
        ScoreLabel.BackgroundTransparency = 1
        ScoreLabel.Text = tostring(scoreVal)
        ScoreLabel.TextColor3 = Color3.fromRGB(110, 220, 255)
        ScoreLabel.TextSize = 10
        ScoreLabel.Font = Enum.Font.GothamBold
        ScoreLabel.TextXAlignment = Enum.TextXAlignment.Center
        ScoreLabel.Parent = Row

        -- Ping Label (Green if okay, Red if not)
        local PingLabel = Instance.new("TextLabel")
        PingLabel.Size = UDim2.new(0.23, -4, 1, 0)
        PingLabel.Position = UDim2.new(0.77, 0, 0, 0)
        PingLabel.BackgroundTransparency = 1
        PingLabel.Text = pingStr
        PingLabel.TextColor3 = pingColor
        PingLabel.TextSize = 10
        PingLabel.Font = Enum.Font.GothamBold
        PingLabel.TextXAlignment = Enum.TextXAlignment.Right
        PingLabel.Parent = Row

        -- Open full profile popup on tap
        Row.MouseButton1Click:Connect(function()
            DispNameLabel.Text = player.DisplayName ~= "" and player.DisplayName or player.Name
            UsernameLabel.Text = "@" .. player.Name
            PopupDetailsLabel.Text = statName .. ": " .. tostring(scoreVal) .. "  |  Ping: " .. pingStr
            
            pcall(function()
                local thumb = Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
                AvatarImage.Image = thumb
            end)
            
            ProfilePopup.Visible = true
        end)
    end

    ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, #players * 29)
end

-- Live event synchronization for joining/leaving and scores
Players.PlayerAdded:Connect(function(player)
    player.ChildAdded:Connect(function(child)
        if child.Name == "leaderstats" then
            child.ChildAdded:Connect(updateLeaderboard)
            for _, stat in ipairs(child:GetChildren()) do
                if stat:IsA("ValueBase") then
                    stat.Changed:Connect(updateLeaderboard)
                end
            end
        end
        updateLeaderboard()
    end)
    updateLeaderboard()
end)

Players.PlayerRemoving:Connect(function()
    task.wait(0.2)
    updateLeaderboard()
end)

for _, player in ipairs(Players:GetPlayers()) do
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        for _, stat in ipairs(leaderstats:GetChildren()) do
            if stat:IsA("ValueBase") then
                stat.Changed:Connect(updateLeaderboard)
            end
        end
    end
end

-- Background refresh loop for live pings and scores
task.spawn(function()
    while true do
        task.wait(2)
        pcall(updateLeaderboard)
    end
end)

-- Initial run
task.spawn(updateLeaderboard)
print("Animated Mobile Leaderboard loaded successfully!")
